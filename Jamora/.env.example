# Copy to .env and edit before `docker compose up`.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=jamora_strapi
POSTGRES_PORT=5439
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
JAMORA_COST_RATIO=0.42
JAMORA_STOREFRONT_URL=http://localhost:3095
JAMORA_ADMIN_API_SECRET=change_me_shared_admin_api_secret

# --- Jamora Admin portal ---
ADMIN_EMAIL=admin@jamora.local
ADMIN_PASSWORD=change_me_admin_password
ADMIN_SESSION_TOKEN=change_me_admin_session_token
CUSTOMER_SESSION_TOKEN=change_me_customer_session_token
ADMIN_WAREHOUSE_EMAIL=warehouse@jamora.local
ADMIN_WAREHOUSE_PASSWORD=change_me_warehouse_password
ADMIN_CONTENT_EMAIL=content@jamora.local
ADMIN_CONTENT_PASSWORD=change_me_content_password
ADMIN_SUPPORT_EMAIL=support@jamora.local
ADMIN_SUPPORT_PASSWORD=change_me_support_password

# --- Strapi secrets (generate strong random values!) ---
# Examples:
#   openssl rand -base64 32
#   openssl rand -base64 32 | tr -d '\n'
STRAPI_APP_KEYS=change_me_key_1,change_me_key_2,change_me_key_3,change_me_key_4
STRAPI_API_TOKEN_SALT=change_me_api_token_salt
STRAPI_ADMIN_JWT_SECRET=change_me_admin_jwt_secret
STRAPI_TRANSFER_TOKEN_SALT=change_me_transfer_token_salt
STRAPI_JWT_SECRET=change_me_jwt_secret

# --- Public URLs / ports ---
STRAPI_PUBLIC_URL=http://localhost:9014
STRAPI_PORT=9014
# Keep false for direct/local Strapi access. Set true only when a trusted,
# sole reverse proxy supplies X-Forwarded-* and Strapi is not publicly reachable.
TRUST_PROXY=false
STOREFRONT_PORT=3095

# --- Storefront -> Strapi ---
# In Docker this is supplied as http://strapi:1337. Use this for local dev.
STRAPI_URL=http://localhost:9014
JAMORA_STOREFRONT_API_SECRET=change_me_storefront_to_strapi_secret
CUSTOMER_ACCOUNTS_ENABLED=false
CUSTOMER_VERIFICATION_DELIVERY_ENABLED=false
# Single-Strapi-process auth protection; use a distributed limiter before scaling out.
CUSTOMER_AUTH_RATE_LIMIT=8
CUSTOMER_AUTH_RATE_WINDOW_MS=60000
CUSTOMER_AUTH_RATE_MAX_BUCKETS=10000
CUSTOMER_AUTH_HASH_CONCURRENCY=4
CUSTOMER_AUTH_HASH_QUEUE_LIMIT=32
STRUCTURED_CHECKOUT_ENABLED=false
MEMBERSHIP_ENABLED=false

# --- Phase 2 payments (disabled by default; examples only, never real credentials) ---
# Bank transfer requires PAYMENTS_ENABLED=true. RoPay requires both
# PAYMENTS_ENABLED=true and ROPAY_ENABLED=true.
PAYMENTS_ENABLED=false
PAYMENT_BENEFICIARY_NAME=Jamora Example SRL
PAYMENT_BENEFICIARY_IBAN=RO49AAAA1B31007593840000
PAYMENT_BENEFICIARY_BANK=Example Bank
# 300-604800 seconds; defaults to 72 hours.
PAYMENT_TRANSFER_TTL_SECONDS=259200

# RoPay remains mock-only in this release. Do not set `live` until a reviewed
# real adapter exists; any mode other than `mock` fails closed.
ROPAY_ENABLED=false
ROPAY_PROVIDER_MODE=mock
ROPAY_CALLBACK_SECRET=change_me_ropay_callback_hmac_secret
# 60-900 seconds; defaults to 600 seconds.
ROPAY_INTENT_TTL_SECONDS=600
# Pre-verification callback guard; single-process in-memory foundation.
ROPAY_RATE_LIMIT=60
ROPAY_RATE_WINDOW_MS=60000
ROPAY_RATE_MAX_BUCKETS=10000
# Verified-provider reference/replay limiter; use a shared limiter before scale-out.
ROPAY_AUTH_RATE_LIMIT=10
ROPAY_AUTH_REPLAY_LIMIT=3
ROPAY_AUTH_RATE_WINDOW_MS=60000
ROPAY_AUTH_RATE_MAX_BUCKETS=10000
